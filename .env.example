# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Optional overrides (defaults shown)
# ORCHESTRATOR_MODEL=claude-sonnet-5-5
# RESEARCHER_MODEL=claude-haiku-4-5
# WRITER_MODEL=claude-sonnet-5-5

# Limits on the agents' autonomy
# MAX_RESEARCH_ROUNDS=3
# MAX_TASKS_PER_ROUND=4
# MAX_RESEARCHER_STEPS=6
# SEARCH_RESULTS_PER_QUERY=5
# PAGE_CHAR_LIMIT=12000

# Paper audit
# AUDITOR_MODEL=claude-sonnet-5-5
# SCOUT_MODEL=claude-haiku-4-5
# ANALYST_MODEL=claude-sonnet-5-5
# MAX_AUDITOR_STEPS=5
# MAX_SCOUT_STEPS=6
# MAX_REFERENCES_AUDITED=60
# MAX_CONTRIBUTIONS=4
# MAX_CANDIDATES_PER_CONTRIBUTION=6

# Scholarly APIs. None of these is required. A contact address is good manners
# towards Crossref and OpenAlex. OpenAlex meters free use by the day; set an
# API key only if you have one with its own allowance.
# SCHOLAR_MAILTO=you@example.com
# OPENALEX_API_KEY=
# OPENALEX_FALLBACK=true

# Evaluation judge (see evals/README.md)
# JUDGE_MODEL=claude-opus-5-5
# JUDGE_EFFORT=medium
